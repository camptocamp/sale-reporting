<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="base_multicompany_reporting_currency.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <div id="multicompany_reporting_currency_setup" position="after">
                <div class="mt16">
                    <label for="multicompany_reporting_amount" />
                    <field name="multicompany_reporting_amount" class="oe_inline" />
                </div>
            </div>
        </field>
    </record>
</odoo>
